# venue-economics: environment for the /api/predict/[model] serverless route.
# Copy to `.env` (gitignored) for local dev, and set the same vars in
# Vercel -> Project -> Settings -> Environment Variables (Production + Preview).
#
# The AWS SDK reads AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from
# the environment automatically. Use a long-lived IAM user scoped to
# sagemaker:InvokeEndpoint on the endpoint, never temporary session creds.

AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Set when the capstone model endpoint ships (docs/PLUG-IN-ENDPOINT.md).
# While unset, /api/predict/oracle-ripple serves the simulated preview.
SAGEMAKER_ENDPOINT_ORACLE=

# Build-time fetch of the Advan-derived POI index (scripts/fetch-pois.mjs).
# Deliberately POIS_-prefixed so they never collide with the runtime AWS_*
# creds above. IAM user `vercel-website-build`, s3:GetObject on
# website-data/* only. Local dev does not need these while src/data/pois.json
# is already on disk.
POIS_AWS_ACCESS_KEY_ID=
POIS_AWS_SECRET_ACCESS_KEY=
POIS_AWS_REGION=us-east-2
POIS_S3_URI=s3://aai-590-group2-capstone/website-data/pois.json
