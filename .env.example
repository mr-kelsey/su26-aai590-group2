# Copy to .env (gitignored) and fill ONLY what you need.
# All `build-now` sources (BART, MLB, CDTFA, OI, eSMR, Open-Meteo, TOT, Wikipedia)
# require NONE of these — an empty .env runs most of the pipeline.
# Team credential values: see docs/05_data_access_guide.md §2.
#
# FORMAT: keep comments on their OWN line. python-dotenv includes trailing
# "# comments" in the parsed value and silently corrupts it.

# ---- AWS coordinates (fill from your account) ----
AWS_ACCOUNT_ID=
AWS_REGION=us-east-2
STUDIO_REGION=us-east-1
S3_BUCKET=
# boto3/CLI credential profile (~/.aws/credentials section name)
AWS_PROFILE=
S3_PREFIX=eia-nowcast
GLUE_SILVER_DB=aai540_silver
GLUE_GOLD_DB=aai540_gold

# ---- local ----
DATA_DIR=./data

# ---- optional source credentials (only for key-needed sources) ----

# pems.dot.ca.gov free account (web login: username + password)
PEMS_USERNAME=
PEMS_PASSWORD=

# api.census.gov (free, instant)
CENSUS_API_KEY=

# ncdc.noaa.gov/cdo-web (free token; optional gauge validation)
NOAA_NCEI_TOKEN=

# develop.purpleair.com (cents per sensor)
PURPLEAIR_API_KEY=

# platform.seatgeek.com (free key; review terms)
SEATGEEK_CLIENT_ID=
